# Archivo de ejemplo para desarrollo local
# Copia este archivo como .env y ajusta las variables según tu entorno

# Configuración de la API
# Para desarrollo local:
VUE_APP_API_URL=http://localhost:5000/api
VUE_APP_PORT=8080

# Para acceso desde red local, usa:
# VUE_APP_API_URL=http://TU_IP_LOCAL:5000/api
# Ejemplo: VUE_APP_API_URL=http://192.168.2.117:5000/api

# Para producción (Railway):
# VUE_APP_API_URL=https://backend-chpc-production.up.railway.app/api
